# Files excluded from the release tarball. The release tarball ships
# already-woven POD, so the weaver configuration and AGENTS notes stay behind.
^weaver\.ini$
^AGENTS\.md$
^mise\.toml$
^\.perltidyrc$
^\.git/
^\.gitignore$
^\.DS_Store$
^_build/
^Build$
^Build\.bat$
^blib/
^MYMETA\.
^pm_to_blib$
^Game-OperationRebuild-
^xt/
~$
\.bak$
\.tmp$
^\.kiro/
